{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/atalaydor/polymarket-1h-seven-canonical-data/schemas/partition-manifest.schema.json",
  "title":"Canonical partition manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","dataset_id","partition_id","asset","venue","timeframe","quality_tier","files","provenance","coverage_start_ns","release_cutoff_ns"],
  "properties":{
    "schema_version":{"const":"1.0.0"},
    "dataset_id":{"const":"polymarket-1h-seven-v1"},
    "partition_id":{"type":"string","pattern":"^(BTC|ETH|SOL|XRP|DOGE|BNB|HYPE)/1h/[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "asset":{"enum":["BTC","ETH","SOL","XRP","DOGE","BNB","HYPE"]},
    "venue":{"const":"polymarket"},
    "timeframe":{"const":"1h"},
    "quality_tier":{"enum":["TIER_A","TIER_B","EXCLUDED"]},
    "files":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/file"}},
    "provenance":{"type":"array","minItems":1,"items":{"type":"object"}},
    "exclusions":{"type":"array","items":{"type":"object","required":["market_id","reason_code"]}},
    "inputs":{"type":"array","items":{"type":"object","required":["source_id","byte_length","sha256"]}},
    "tool_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "parameters":{"type":"object"},
    "statistics":{"type":"object"},
    "coverage_start_ns":{"type":"integer"},
    "release_cutoff_ns":{"type":"integer"}
  },
  "$defs":{"file":{"type":"object","additionalProperties":false,"required":["path","byte_length","sha256"],"properties":{"path":{"type":"string"},"byte_length":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}}
}
